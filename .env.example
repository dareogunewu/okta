# Okta Configuration
# Copy this file to .env and fill in your credentials

# Your Okta domain (without https://)
# Example: your-domain.okta.com or your-domain.oktapreview.com
OKTA_DOMAIN=your-domain.okta.com

# ===== Option 1: OAuth 2.0 (Recommended) =====
# Client ID from your OAuth 2.0 application
OKTA_CLIENT_ID=your_client_id_here

# Path to your private key file
OKTA_PRIVATE_KEY_PATH=/path/to/private_key.pem

# ===== Option 2: API Token (Legacy) =====
# API Token from Okta Admin Console (Security > API > Tokens)
# OKTA_API_TOKEN=your_api_token_here

# Note: Use EITHER OAuth 2.0 (CLIENT_ID + PRIVATE_KEY_PATH) OR API_TOKEN, not both
